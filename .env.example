# Alpaca Paper Trading
ALPACA_KEY=your_alpaca_key_here
ALPACA_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Target politician to copy (Capitol Trades slug)
TARGET_POLITICIAN=tim-moore
TARGET_POLITICIAN_DISPLAY=Tim Moore

# Trade sizing — fraction of portfolio per trade
TRADE_FRACTION=0.05
MIN_TRADE_USD=100
MAX_TRADE_USD=5000

# How many minutes between checks
CHECK_INTERVAL_MINUTES=30

# Only copy trades filed within the last N days (prevents re-copying old history)
LOOKBACK_DAYS=30
